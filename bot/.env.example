# Telegram credentials (get from https://my.telegram.org)
API_ID=
API_HASH=
BOT_TOKEN=
BOT_USERNAME=

# PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@localhost:5432/chatochi

# Admins — comma-separated list of Telegram user IDs
ADMIN_IDS=
# (legacy single-admin fallback still supported)
# ADMIN_ID=

# Economy
NEW_USER_BONUS=5
REFERRAL_REWARD=20
PREMIUM_SEARCH_PRICE=50
PREMIUM_SEARCH_DURATION_MIN=30

# Rate limits / anti-abuse
REPORT_COOLDOWN_SEC=60
SEARCH_COOLDOWN_SEC=3
MSG_PER_MIN_LIMIT=60

# Matchmaking
MAX_SEARCH_QUEUE_SECONDS=120
INACTIVE_USER_TIMEOUT_HOURS=168

# Sponsor channel gate (1=on, 0=off)
ENABLE_SPONSOR_CHECK=1
